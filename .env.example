# Postgres Database Configuration
POSTGRES_USER=benchmark_user
POSTGRES_PASSWORD=benchmark_pass
POSTGRES_DB=benchmark_db
DATABASE_URL=postgresql://benchmark_user:benchmark_pass@localhost:5432/benchmark_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda Configuration
# Local dev: localhost:9092 | Docker Compose: redpanda:29092 (set via docker-compose.yml env)
KAFKA_BROKERS=localhost:9092

# QuestDB Configuration
# Local dev: http://localhost:9003 | Docker Compose: http://questdb:9000 (set via docker-compose.yml env)
QUESTDB_URL=http://localhost:9003

# Sandbox Networking
# In local dev, sandbox containers are reachable on 127.0.0.1 (the host loopback).
# In Docker Compose, set this to host.docker.internal so containers can reach the host.
# Docker Compose sets this automatically via docker-compose.yml; only override here for local dev.
SANDBOX_HOST=127.0.0.1

# Service Ports (Local Dev)
SUBMISSION_API_PORT=3001
BUILD_RUNNER_PORT=3002
SANDBOX_MANAGER_PORT=3003
LOAD_GENERATOR_CONTROLLER_PORT=3004
TELEMETRY_INGESTOR_PORT=3005
CORRECTNESS_ENGINE_PORT=3006
SCORING_ENGINE_PORT=3007
LEADERBOARD_API_PORT=3008

# Web App Port
VITE_PORT=5173

# gVisor / Sandbox Security Configuration
# Set to 'runsc' if you have gVisor installed and configured in Docker
# DOCKER_RUNTIME=runsc

# Scoring Weights (optional — defaults shown)
# WEIGHT_LATENCY=0.30
# WEIGHT_THROUGHPUT=0.40
# WEIGHT_CORRECTNESS=0.30
# LATENCY_FLOOR_MS=10
# LATENCY_CEILING_MS=100
# THROUGHPUT_TARGET=10000
# CORRECTNESS_GATE=0.5
