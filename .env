# Postgres Database Configuration
POSTGRES_USER=benchmark_user
POSTGRES_PASSWORD=benchmark_pass
POSTGRES_DB=benchmark_db
DATABASE_URL=postgresql://benchmark_user:benchmark_pass@localhost:5432/benchmark_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda Configuration (local dev)
KAFKA_BROKERS=localhost:9092

# QuestDB Configuration (local dev)
QUESTDB_URL=http://localhost:9003

# Sandbox Networking (local dev — Docker Compose overrides this via docker-compose.yml)
SANDBOX_HOST=127.0.0.1

# Service Ports (Local Dev)
SUBMISSION_API_PORT=3001
BUILD_RUNNER_PORT=3002
SANDBOX_MANAGER_PORT=3003
LOAD_GENERATOR_CONTROLLER_PORT=3004
TELEMETRY_INGESTOR_PORT=3005
CORRECTNESS_ENGINE_PORT=3006
SCORING_ENGINE_PORT=3007
LEADERBOARD_API_PORT=3008

# Web App Port
VITE_PORT=5173

# gVisor / Sandbox Security Configuration
# Set to 'runsc' if you have gVisor installed and configured in Docker
# DOCKER_RUNTIME=runsc
